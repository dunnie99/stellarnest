# Test environment.
#
# These contract IDs are structurally valid but point at nothing — every test
# stubs the service layer, so no request is ever made. They exist so
# `IS_CONFIGURED` is true and the tests exercise the configured code paths
# rather than the setup banner.
VITE_SAVINGS_CONTRACT_ID=CD4ZQQYQJKB6DZWH5KIWTPCHTRFSTAEMX5KNGGGAR5TZF322ZCLR2HKU
VITE_TREASURY_CONTRACT_ID=CD4ZQBOCX7M6CQIZTHEH4MAOS5XJ52JKZLRZXKYAL2CQ2TWOJLPGUKCA

VITE_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
VITE_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
VITE_EVENT_POLL_MS=60000

# Keep test output readable; failures are asserted, not logged.
VITE_LOG_LEVEL=silent
