# Production build settings.
#
# Contract IDs are intentionally left blank: they are supplied by the deploy
# pipeline (or a local `.env`) so a build never ships a hard-coded address.
VITE_SAVINGS_CONTRACT_ID=
VITE_TREASURY_CONTRACT_ID=

VITE_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
VITE_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
VITE_EVENT_POLL_MS=5000

# Only warnings and errors in a production bundle.
VITE_LOG_LEVEL=warn
