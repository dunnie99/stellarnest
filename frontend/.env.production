# Production build settings for the public Stellar Testnet deployment.
#
# Vite loads `.env.production` during `vite build`, including builds on Vercel.
# These addresses are public and must not be blank: blank values take precedence
# over `.env` and make the hosted app display its configuration banner.
VITE_SAVINGS_CONTRACT_ID=CCFOC4U7OAABRXJQXLVRZ7FL5UMQ5T6BXJ53WNCYJXKE7SVHS3I55R2R
VITE_TREASURY_CONTRACT_ID=CDKVSTRN77GA344RTH6IE7HJZZFAZZFJI3KASTFCU3AENS2XMDOLDJP5

VITE_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
VITE_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
VITE_EVENT_POLL_MS=5000

# Only warnings and errors in a production bundle.
VITE_LOG_LEVEL=warn
