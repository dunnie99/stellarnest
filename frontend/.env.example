# Deployed contracts on the Stellar Testnet.
# `../scripts/deploy/deploy.sh` rewrites these in .env when you deploy your own.
VITE_SAVINGS_CONTRACT_ID=CCFOC4U7OAABRXJQXLVRZ7FL5UMQ5T6BXJ53WNCYJXKE7SVHS3I55R2R
VITE_TREASURY_CONTRACT_ID=CDKVSTRN77GA344RTH6IE7HJZZFAZZFJI3KASTFCU3AENS2XMDOLDJP5

# Soroban RPC endpoint (Testnet).
VITE_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Network passphrase. Must match the network the contracts were deployed to.
VITE_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Live activity feed poll interval, in milliseconds.
VITE_EVENT_POLL_MS=5000

# Logging verbosity: debug | info | warn | error | silent
VITE_LOG_LEVEL=info
